# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- LLM -------------------------------------------------------------------
# PydanticAI "provider:model" — use the provider's API model ID (not Cursor aliases).
# Switch provider by changing this line and setting the matching API key below.
JIRAFA_MODEL=anthropic:claude-sonnet-5-5
# JIRAFA_MODEL=anthropic:claude-opus-5-5
# JIRAFA_MODEL=openai:gpt-6.1-sol
# JIRAFA_MODEL=google:gemini-3.8-flash
# JIRAFA_MODEL=google:gemini-4-argon

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Jira ------------------------------------------------------------------
# "demo" = fake tickets (no Jira needed) | "real" = your Jira Cloud
JIRA_MODE=demo
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
